      <column caption='Price Range' datatype='integer' name='[Calculation_0454694102212608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Max_Price] - [Min_Price]' />
      </column>
      <column caption='Price Spread % ' datatype='real' name='[Calculation_0454694102499329]' role='measure' type='quantitative'>
